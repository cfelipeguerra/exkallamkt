# URL pública (HTTPS) onde a aplicação vai rodar — usada nos links, na tag e no webhook
BASE_URL=https://track.suaagencia.com.br
PORT=3000

# Acesso ao painel (/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# 32 bytes em hex para criptografar tokens dos clientes. Gere com: openssl rand -hex 32
# ATENÇÃO: se perder ou trocar esta chave, os tokens salvos deixam de funcionar.
ENCRYPTION_KEY=

# Banco SQLite (no Docker fica no volume /app/data)
DB_PATH=./data/vendeuzap.db

# Evolution API (usada para configurar o webhook e buscar etiquetas automaticamente)
EVOLUTION_URL=https://evolution.suaagencia.com.br
EVOLUTION_API_KEY=

# Meta Graph API
META_GRAPH_VERSION=v25.0

# Google Ads API (opcional; sem isso use o feed CSV de upload agendado)
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# true = registra os eventos mas NÃO envia para as plataformas (homologação)
DRY_RUN=false
DISPATCHER_INTERVAL_MS=10000
DEFAULT_COUNTRY_CODE=55
